# Database Configuration
# Local: localhost | Vercel: Hostname from Aiven, TiDB Cloud, Railway, AWS RDS, etc.
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DB=airport_managment_system

# Enable SSL for cloud databases on Vercel (true/false)
MYSQL_SSL=false

# Optional connection timeout in seconds (default is 5)
MYSQL_CONNECT_TIMEOUT=5

# Flask Session Security Key
SECRET_KEY=airport_management_super_secret_key_2026
